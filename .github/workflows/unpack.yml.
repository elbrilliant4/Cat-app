# GitHub's web uploader doesn't extract zip files. If a .zip lands in the repo
# root, this unpacks it in place, removes the zip and republishes the site.
name: Unpack uploaded zip

on:
  push:
    branches: [main]
    paths: ['*.zip', '.github/workflows/unpack.yml']
  workflow_dispatch:

permissions:
  contents: write
  actions: write

jobs:
  unpack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unpack zip files
        id: unpack
        run: |
          shopt -s nullglob dotglob
          zips=( *.zip )
          if [ ${#zips[@]} -eq 0 ]; then echo "No zip to unpack."; exit 0; fi
          for z in "${zips[@]}"; do
            tmp=$(mktemp -d)
            unzip -q "$z" -d "$tmp"
            entries=( "$tmp"/* )
            src="$tmp"
            # Zips that wrap everything in one folder are unpacked from inside it.
            if [ ${#entries[@]} -eq 1 ] && [ -d "${entries[0]}" ]; then src="${entries[0]}"; fi
            # The workflow token may not write workflow files; those are managed separately.
            rm -rf "$src/.github/workflows"
            cp -a "$src"/. .
            git rm -q "$z"
          done
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "Unpack uploaded zip"
          git push
          echo "changed=true" >> "$GITHUB_OUTPUT"
      - name: Republish the site
        if: steps.unpack.outputs.changed == 'true'
        run: gh workflow run pages.yml --ref main || echo "Pages deploy not started; check Settings > Pages."
        env:
          GH_TOKEN: ${{ github.token }}
